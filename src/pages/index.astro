---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import PlayerConsole from "../components/PlayerConsole.astro";
import PlaylistDrawer from "../components/PlaylistDrawer.astro";
import SuggestionModal from "../components/SuggestionModal.astro";
import FeedbackNoteModal from "../components/FeedbackNoteModal.astro";
import songsData from "../data/songs.json";
---

<MainLayout>
  <!-- Minimalist Quiet Top Bar -->
  <Header />

  <!-- Centered Floating Player Environment -->
  <main
    class="flex-1 w-full px-3 sm:px-8 py-3 sm:py-8 flex items-center justify-center"
  >
    <div class="w-full max-w-lg px-1 sm:px-4">
      <PlayerConsole />
    </div>
  </main>

  <!-- Mobile & Slide-Out Song Queue -->
  <PlaylistDrawer />

  <!-- Formspree Modals -->
  <SuggestionModal />
  <FeedbackNoteModal />

  <!-- Creator Footer & Social Links -->
  <footer class="w-full py-4 px-4 sm:px-6 shrink-0 z-10">
    <div
      class="max-w-4xl mx-auto glass-pill-footer px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left"
    >
      <!-- Left Profile & Poetic Tagline -->
      <div class="space-y-1">
        <p class="font-serif text-sm text-[#f5f0e1] tracking-wide">
          Made by <span class="text-[#ff9f1c]">Kirtan</span>
        </p>
        <p class="font-sans font-light text-xs text-[#a39b8e] italic">
          for people who like staying a little longer.
        </p>
        <div class="flex items-center gap-4 text-xs font-mono text-[#a39b8e] pt-1">
          <a
            href="https://youtube.com/playlist?list=PLNRBgd_0X_og&si=r733CP_EUCr2GRxA"
            target="_blank"
            rel="noopener noreferrer"
            title="YouTube Playlist"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a
            href="https://github.com/kirtanpatel01/chatpate"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub Repository"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <a
            href="https://instagram.com/kjpatel.dev"
            target="_blank"
            rel="noopener noreferrer"
            title="Instagram Profile"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </div>
      </div>

      <!-- Right Formspree Triggers -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="open-suggestion-btn"
          class="flex items-center gap-1.5 text-xs font-sans text-[#f5f0e1] bg-white/10 hover:bg-[#ff9f1c]/25 hover:text-[#ff9f1c] px-3.5 py-2 transition-all cursor-pointer"
        >
          <span>+ Suggest a Song</span>
        </button>
        <button
          type="button"
          id="open-feedback-btn"
          class="flex items-center gap-1.5 text-xs font-sans text-[#f5f0e1] bg-white/10 hover:bg-[#ff9f1c]/25 hover:text-[#ff9f1c] px-3.5 py-2 transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
          <span>Leave a note</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- Client Audio Hydration & Page Events Script -->
  <script is:inline define:vars={{ songsData }}>
    function updateSliderFill(slider, percent) {
      if (!slider) return;
      const val = Math.min(100, Math.max(0, percent));
      slider.style.background = `linear-gradient(to right, #ff9f1c 0%, #ff9f1c ${val}%, rgba(245, 240, 225, 0.15) ${val}%, rgba(245, 240, 225, 0.15) 100%)`;
    }

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }

    if (!window.chatpateTimerStarted) {
      window.chatpateTimerStarted = true;
      setInterval(() => {
        const st = window.chatpateState;
        if (st && st.isPlayerReady && st.player && st.player.getCurrentTime) {
          const current = st.player.getCurrentTime() || 0;
          const total = st.player.getDuration() || 0;
          const slider = document.getElementById("player-seek-slider");
          const timeCur = document.getElementById("player-current-time");
          const timeTot = document.getElementById("player-total-duration");
          if (slider && total > 0) {
            const percent = (current / total) * 100;
            slider.value = percent;
            updateSliderFill(slider, percent);
          }
          if (timeCur) timeCur.innerText = formatTime(current);
          if (timeTot) timeTot.innerText = formatTime(total);

          if (current > 0) {
            localStorage.setItem("chatpate_last_playback_time", current.toFixed(2));
            localStorage.setItem("chatpate_last_song_index", st.currentSongIndex);
            if (songsData[st.currentSongIndex]) {
              localStorage.setItem("chatpate_last_song_id", songsData[st.currentSongIndex].id);
            }
          }
        }
      }, 500);
    }

    function initHomePageEvents() {
      const st = window.chatpateState;
      if (!st) return;

      const seekSlider = document.getElementById("player-seek-slider");
      if (seekSlider) updateSliderFill(seekSlider, 0);

      const volSlider = document.getElementById("player-volume-slider");
      if (volSlider) {
        updateSliderFill(volSlider, volSlider.value);
        volSlider.oninput = (e) => {
          updateSliderFill(volSlider, e.target.value);
          if (st.isPlayerReady && st.player && st.player.setVolume) {
            st.player.setVolume(e.target.value);
          }
        };
      }

      if (seekSlider) {
        seekSlider.oninput = (e) => {
          const val = e.target.value;
          updateSliderFill(seekSlider, val);
          if (st.isPlayerReady && st.player && st.player.getDuration) {
            const seekTo = (val / 100) * st.player.getDuration();
            st.player.seekTo(seekTo, true);
          }
        };
      }

      const mainPlayBtn = document.getElementById("player-play-toggle-btn");
      if (mainPlayBtn) {
        mainPlayBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          if (!st.isPlayerReady || !st.player) return;
          if (st.isPlaying) st.player.pauseVideo();
          else st.player.playVideo();
        };
      }

      const drawerPlayBtn = document.getElementById("drawer-bottom-play-btn");
      if (drawerPlayBtn) {
        drawerPlayBtn.onclick = () => {
          if (mainPlayBtn) mainPlayBtn.click();
        };
      }

      const nextBtn = document.getElementById("player-next-btn");
      if (nextBtn) {
        nextBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          if (window.playNextTrack) window.playNextTrack();
        };
      }

      const drawerNextBtn = document.getElementById("drawer-bottom-next-btn");
      if (drawerNextBtn) {
        drawerNextBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          if (window.playNextTrack) window.playNextTrack();
        };
      }

      const prevBtn = document.getElementById("player-prev-btn");
      if (prevBtn) {
        prevBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          if (window.playPrevTrack) window.playPrevTrack();
        };
      }

      const shuffleBtn = document.getElementById("player-shuffle-btn");
      if (shuffleBtn) {
        shuffleBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          st.isShuffle = !st.isShuffle;
          document.getElementById("shuffle-indicator")?.classList.toggle("hidden", !st.isShuffle);
        };
      }

      const repeatBtn = document.getElementById("player-repeat-btn");
      if (repeatBtn) {
        repeatBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          st.isRepeat = !st.isRepeat;
          document.getElementById("repeat-indicator")?.classList.toggle("hidden", !st.isRepeat);
        };
      }

      const muteBtn = document.getElementById("player-mute-btn");
      if (muteBtn) {
        muteBtn.onclick = () => {
          if (window.playSFX) window.playSFX("click");
          if (!st.isPlayerReady || !st.player) return;
          st.isMuted = !st.isMuted;
          if (st.isMuted) st.player.mute();
          else st.player.unMute();
          muteBtn.innerHTML = st.isMuted
            ? `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>`
            : `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>`;
        };
      }

      function updateExcludedUI() {
        document.querySelectorAll(".drawer-song-item").forEach((item) => {
          const songId = item.getAttribute("data-song-id");
          const isExcluded = st.excludedSongIds.has(songId);
          const btn = item.querySelector(".exclude-toggle-btn");
          if (btn) {
            btn.classList.toggle("text-red-400", isExcluded);
            btn.classList.toggle("text-[#a39b8e]", !isExcluded);
          }
          item.classList.toggle("opacity-40", isExcluded);
        });
      }
      updateExcludedUI();

      document.querySelectorAll(".exclude-toggle-btn").forEach((btn) => {
        btn.onclick = (e) => {
          e.stopPropagation();
          if (window.playSFX) window.playSFX("click");
          const songId = btn.getAttribute("data-exclude-id");
          if (!songId) return;
          if (st.excludedSongIds.has(songId)) st.excludedSongIds.delete(songId);
          else st.excludedSongIds.add(songId);
          localStorage.setItem(
            "chatpate_excluded_songs",
            JSON.stringify([...st.excludedSongIds]),
          );
          updateExcludedUI();
        };
      });

      document.querySelectorAll(".drawer-song-item").forEach((item) => {
        item.onclick = () => {
          const index = parseInt(item.getAttribute("data-drawer-index"), 10);
          if (!isNaN(index) && window.loadSong) window.loadSong(index, true);
        };
      });

      document.querySelectorAll(".queue-song-item").forEach((item) => {
        item.onclick = () => {
          const songId = item.getAttribute("data-song-id");
          const index = songsData.findIndex((s) => s.id === songId);
          if (index !== -1 && window.loadSong) window.loadSong(index, true);
        };
      });

      const searchInput = document.getElementById("drawer-search-input");
      if (searchInput) {
        searchInput.oninput = (e) => {
          const query = e.target.value.toLowerCase().trim();
          let visibleCount = 0;
          document.querySelectorAll(".drawer-song-item").forEach((item) => {
            const title = (item.getAttribute("data-song-title") || "").toLowerCase();
            const artist = (item.getAttribute("data-song-artist") || "").toLowerCase();
            const matches = title.includes(query) || artist.includes(query);
            item.classList.toggle("hidden", !matches);
            if (matches) visibleCount++;
          });
          const countEl = document.getElementById("drawer-count");
          if (countEl) countEl.innerText = String(visibleCount);
        };
      }

      const drawer = document.getElementById("playlist-drawer");
      const drawerBackdrop = document.getElementById("drawer-backdrop");

      function openDrawer() {
        if (window.playSFX) window.playSFX("click");
        if (drawer) drawer.classList.remove("translate-x-full");
        if (drawerBackdrop) {
          drawerBackdrop.classList.remove("hidden");
          setTimeout(() => drawerBackdrop.classList.remove("opacity-0"), 10);
        }
      }

      function closeDrawer() {
        if (window.playSFX) window.playSFX("click");
        if (drawer) drawer.classList.add("translate-x-full");
        if (drawerBackdrop) {
          drawerBackdrop.classList.add("opacity-0");
          setTimeout(() => drawerBackdrop.classList.add("hidden"), 300);
        }
      }

      const openDrawerBtn = document.getElementById("drawer-open-btn");
      if (openDrawerBtn) openDrawerBtn.onclick = openDrawer;
      const closeDrawerBtn = document.getElementById("drawer-close-btn");
      if (closeDrawerBtn) closeDrawerBtn.onclick = closeDrawer;
      if (drawerBackdrop) drawerBackdrop.onclick = closeDrawer;

      const sugModal = document.getElementById("feedback-modal");
      const sugBackdrop = document.getElementById("feedback-backdrop");
      const openSugBtn = document.getElementById("open-suggestion-btn");
      const closeSugBtn = document.getElementById("feedback-close-btn");

      const noteModal = document.getElementById("general-feedback-modal");
      const noteBackdrop = document.getElementById("general-feedback-backdrop");
      const openNoteBtn = document.getElementById("open-feedback-btn");
      const closeNoteBtn = document.getElementById("general-feedback-close-btn");

      const openModalHelper = (modal, backdrop) => {
        if (window.playSFX) window.playSFX("click");
        if (!modal || !backdrop) return;
        backdrop.classList.remove("pointer-events-none", "opacity-0");
        modal.classList.remove("pointer-events-none", "opacity-0", "scale-95");
      };

      const closeModalHelper = (modal, backdrop) => {
        if (window.playSFX) window.playSFX("click");
        if (!modal || !backdrop) return;
        backdrop.classList.add("opacity-0", "pointer-events-none");
        modal.classList.add("opacity-0", "scale-95", "pointer-events-none");
      };

      if (openSugBtn) openSugBtn.onclick = () => openModalHelper(sugModal, sugBackdrop);
      if (closeSugBtn) closeSugBtn.onclick = () => closeModalHelper(sugModal, sugBackdrop);
      if (sugBackdrop) sugBackdrop.onclick = () => closeModalHelper(sugModal, sugBackdrop);

      if (openNoteBtn) openNoteBtn.onclick = () => openModalHelper(noteModal, noteBackdrop);
      if (closeNoteBtn) closeNoteBtn.onclick = () => closeModalHelper(noteModal, noteBackdrop);
      if (noteBackdrop) noteBackdrop.onclick = () => closeModalHelper(noteModal, noteBackdrop);

      window.onkeydown = (e) => {
        if (["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName))
          return;
        if (e.code === "Space" || e.key === "k" || e.key === "K") {
          e.preventDefault();
          document.getElementById("player-play-toggle-btn")?.click();
        } else if (e.key === "ArrowRight" || e.key === "l" || e.key === "L") {
          if (window.playNextTrack) window.playNextTrack();
        } else if (e.key === "ArrowLeft" || e.key === "j" || e.key === "J") {
          if (window.playPrevTrack) window.playPrevTrack();
        } else if (e.key === "s" || e.key === "S") {
          document.getElementById("player-shuffle-btn")?.click();
        } else if (e.key === "r" || e.key === "R") {
          document.getElementById("player-repeat-btn")?.click();
        } else if (e.key === "m" || e.key === "M") {
          document.getElementById("player-mute-btn")?.click();
        } else if (e.key === "q" || e.key === "Q") {
          openDrawer();
        } else if (e.key === "Escape") {
          closeDrawer();
        }
      };
    }

    document.addEventListener("DOMContentLoaded", initHomePageEvents);
    document.addEventListener("astro:page-load", initHomePageEvents);
  </script>
</MainLayout>
