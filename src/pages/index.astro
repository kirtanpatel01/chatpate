---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import PlayerConsole from "../components/PlayerConsole.astro";
import PlaylistDrawer from "../components/PlaylistDrawer.astro";
import SuggestionModal from "../components/SuggestionModal.astro";
import FeedbackNoteModal from "../components/FeedbackNoteModal.astro";
import songsData from "../data/songs.json";
---

<MainLayout>
  <!-- Minimalist Quiet Top Bar -->
  <Header />

  <!-- Centered Floating Player Environment -->
  <main
    class="flex-1 w-full px-3 sm:px-8 py-3 sm:py-8 flex items-center justify-center"
  >
    <div class="w-full max-w-lg px-1 sm:px-4">
      <PlayerConsole />
    </div>
  </main>

  <!-- Mobile & Slide-Out Song Queue -->
  <PlaylistDrawer />

  <!-- Formspree Modals -->
  <SuggestionModal />
  <FeedbackNoteModal />

  <!-- Creator Footer & Social Links -->
  <footer class="w-full py-4 px-4 sm:px-6 shrink-0 z-10">
    <div
      class="max-w-4xl mx-auto glass-pill-footer px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left"
    >
      <!-- Left Profile & Poetic Tagline -->
      <div class="space-y-1">
        <p class="font-serif text-sm text-[#f5f0e1] tracking-wide">
          Made by <span class="text-[#ff9f1c]">Kirtan</span>
        </p>
        <p class="font-sans font-light text-xs text-[#a39b8e] italic">
          for people who like staying a little longer.
        </p>
        <div class="flex items-center gap-4 text-xs font-mono text-[#a39b8e] pt-1">
          <a
            href="https://youtube.com/playlist?list=PLNRBgd_0X_og&si=r733CP_EUCr2GRxA"
            target="_blank"
            rel="noopener noreferrer"
            title="YouTube Playlist"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a
            href="https://github.com/kirtanpatel01/chatpate"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub Repository"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <a
            href="https://instagram.com/kjpatel.dev"
            target="_blank"
            rel="noopener noreferrer"
            title="Instagram Profile"
            class="hover:text-[#ff9f1c] transition-colors"
          >
            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </div>
      </div>

      <!-- Right Formspree Triggers -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="open-suggestion-btn"
          class="flex items-center gap-1.5 text-xs font-sans text-[#f5f0e1] bg-white/10 hover:bg-[#ff9f1c]/25 hover:text-[#ff9f1c] px-3.5 py-2 transition-all cursor-pointer"
        >
          <span>+ Suggest a Song</span>
        </button>
        <button
          type="button"
          id="open-feedback-btn"
          class="flex items-center gap-1.5 text-xs font-sans text-[#f5f0e1] bg-white/10 hover:bg-[#ff9f1c]/25 hover:text-[#ff9f1c] px-3.5 py-2 transition-all cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
          <span>Leave a note</span>
        </button>
      </div>
    </div>
  </footer>

  <!-- Client Audio Hydration Script -->
  <script is:inline define:vars={{ songsData }}>
    let player = null;
    let isPlayerReady = false;
    let isPlaying = false;
    
    // Check URL query param ?play=SONG_ID
    const urlParams = new URLSearchParams(window.location.search);
    const playParamId = urlParams.get("play");

    // Restore last played song & playback position from localStorage
    const savedSongId = localStorage.getItem("chatpate_last_song_id");
    const savedSongIdxRaw = localStorage.getItem("chatpate_last_song_index");
    let initialIndex = 0;
    let savedTime = 0;

    if (playParamId) {
      const playIdx = songsData.findIndex((s) => s.id === playParamId);
      if (playIdx !== -1) {
        initialIndex = playIdx;
      }
    } else if (savedSongId) {
      const foundIdx = songsData.findIndex((s) => s.id === savedSongId);
      if (foundIdx !== -1) {
        initialIndex = foundIdx;
        savedTime = parseFloat(localStorage.getItem("chatpate_last_playback_time") || "0");
      }
    } else if (savedSongIdxRaw !== null) {
      const parsed = parseInt(savedSongIdxRaw, 10);
      if (!isNaN(parsed) && parsed >= 0 && parsed < songsData.length) {
        initialIndex = parsed;
        savedTime = parseFloat(localStorage.getItem("chatpate_last_playback_time") || "0");
      }
    }
    let currentSongIndex = initialIndex;
    if (isNaN(savedTime) || savedTime < 0) savedTime = 0;

    let isShuffle = false;
    let isRepeat = false;
    let isMuted = false;
    let sfxEnabled = true;
    let excludedSongIds = new Set(
      JSON.parse(localStorage.getItem("chatpate_excluded_songs") || "[]"),
    );

    // Web Audio UI Sound Effects
    const playSFX = (type) => {
      if (!sfxEnabled) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        const now = ctx.currentTime;
        if (type === "click") {
          osc.frequency.setValueAtTime(350, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.04);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.04);
          osc.start(now);
          osc.stop(now + 0.04);
        } else if (type === "play") {
          osc.frequency.setValueAtTime(250, now);
          osc.frequency.exponentialRampToValueAtTime(500, now + 0.08);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
          osc.start(now);
          osc.stop(now + 0.08);
        }
      } catch (e) {}
    };

    // YouTube API Load
    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScriptTag = document.getElementsByTagName("script")[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    window.onYouTubeIframeAPIReady = () => {
      const initialSong = songsData[currentSongIndex] || songsData[0];
      player = new YT.Player("yt-player-iframe", {
        height: "100%",
        width: "100%",
        videoId: initialSong?.id || "5RT6QMKJTjQ",
        playerVars: {
          playsinline: 1,
          autoplay: 0,
          controls: 1,
          rel: 0,
          modestbranding: 1,
          start: Math.floor(savedTime),
        },
        events: {
          onReady: onPlayerReady,
          onStateChange: onPlayerStateChange,
          onError: onPlayerError,
        },
      });
    };

    function onPlayerReady(event) {
      isPlayerReady = true;
      if (savedTime > 0 && player && player.seekTo) {
        try {
          player.seekTo(savedTime, true);
        } catch (e) {}
      }
      updateUI();
      startProgressTimer();
    }

    function onPlayerStateChange(event) {
      if (event.data === YT.PlayerState.PLAYING) {
        isPlaying = true;
        updatePlayIcons();
      } else if (event.data === YT.PlayerState.PAUSED) {
        isPlaying = false;
        updatePlayIcons();
      } else if (event.data === YT.PlayerState.ENDED) {
        isPlaying = false;
        handleTrackEnd();
      }
    }

    function onPlayerError(event) {
      console.warn("YouTube Player error:", event.data);
      const fallbackView = document.getElementById("player-fallback-view");
      const fallbackTitle = document.getElementById("fallback-song-title");
      if (fallbackView) {
        fallbackView.classList.remove("hidden");
        fallbackView.classList.add("flex");
        if (fallbackTitle)
          fallbackTitle.innerText =
            songsData[currentSongIndex]?.title || "Playback Error";
      }
      setTimeout(() => {
        playNextTrack();
      }, 3500);
    }

    function loadSong(index, autoPlay = true) {
      if (index < 0 || index >= songsData.length) return;
      currentSongIndex = index;
      const song = songsData[currentSongIndex];

      savedTime = 0;
      localStorage.setItem("chatpate_last_song_index", currentSongIndex);
      localStorage.setItem("chatpate_last_song_id", song.id);
      localStorage.setItem("chatpate_last_playback_time", "0");

      const fallbackView = document.getElementById("player-fallback-view");
      if (fallbackView) {
        fallbackView.classList.add("hidden");
        fallbackView.classList.remove("flex");
      }

      if (isPlayerReady && player) {
        player.loadVideoById(song.id);
        if (!autoPlay) player.pauseVideo();
      }

      updateUI();
      playSFX("play");
    }

    function playNextTrack() {
      if (isRepeat) {
        loadSong(currentSongIndex, true);
        return;
      }
      let nextIndex = currentSongIndex;
      let count = 0;
      do {
        if (isShuffle) {
          nextIndex = Math.floor(Math.random() * songsData.length);
        } else {
          nextIndex = (nextIndex + 1) % songsData.length;
        }
        count++;
      } while (
        excludedSongIds.has(songsData[nextIndex]?.id) &&
        count < songsData.length
      );

      loadSong(nextIndex, true);
    }

    function playPrevTrack() {
      let prevIndex = currentSongIndex;
      let count = 0;
      do {
        prevIndex = (prevIndex - 1 + songsData.length) % songsData.length;
        count++;
      } while (
        excludedSongIds.has(songsData[prevIndex]?.id) &&
        count < songsData.length
      );

      loadSong(prevIndex, true);
    }

    function handleTrackEnd() {
      playNextTrack();
    }

    function updatePlayIcons() {
      const playBtnIcons = document.querySelectorAll("#play-icon");
      playBtnIcons.forEach((icon) => {
        if (icon) {
          icon.innerHTML = isPlaying
            ? `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`
            : `<svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
        }
      });
      const drawerPlayIcons = document.querySelectorAll("#drawer-play-icon");
      drawerPlayIcons.forEach((icon) => {
        if (icon) {
          icon.innerHTML = isPlaying
            ? `<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`
            : `<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
        }
      });
    }

    function updateUI() {
      const song = songsData[currentSongIndex];
      if (!song) return;

      const titleEl = document.getElementById("player-song-title");
      const artistEl = document.getElementById("player-song-artist");
      const numEl = document.getElementById("player-track-number");

      if (titleEl) titleEl.innerText = song.title;
      if (artistEl) artistEl.innerText = song.artist;
      if (numEl)
        numEl.innerText = `Track ${song.trackNumber} of ${songsData.length}`;

      const upNextSong = songsData[(currentSongIndex + 1) % songsData.length];
      const upNextEl = document.getElementById("player-up-next-title");
      if (upNextEl && upNextSong)
        upNextEl.innerText = `${upNextSong.title} — ${upNextSong.artist}`;

      const drawerSrEl = document.getElementById("drawer-current-sr");
      const drawerBottomTitle = document.getElementById("drawer-bottom-song-title");
      const drawerBottomArtist = document.getElementById("drawer-bottom-song-artist");
      const drawerBottomThumb = document.getElementById("drawer-bottom-song-thumb");

      if (drawerSrEl) drawerSrEl.innerText = `${currentSongIndex + 1} of ${songsData.length}`;
      if (drawerBottomTitle) drawerBottomTitle.innerText = song.title;
      if (drawerBottomArtist) drawerBottomArtist.innerText = song.artist;
      if (drawerBottomThumb && song.id) {
        drawerBottomThumb.src = `https://img.youtube.com/vi/${song.id}/mqdefault.jpg`;
      }

      document.querySelectorAll(".drawer-song-item, .queue-song-item").forEach((item) => {
        const itemId = item.getAttribute("data-song-id");
        const titleText = item.querySelector(".drawer-title-text, h4");
        const playingBadge = item.querySelector(".now-playing-badge");
        if (itemId === song.id) {
          item.classList.add("bg-[#ff9f1c]/25", "shadow-lg");
          item.classList.remove("bg-[#150f24]", "bg-white/[0.03]");
          if (titleText) {
            titleText.classList.add("text-[#ff9f1c]", "font-bold");
            titleText.classList.remove("text-[#f5f0e1]", "text-slate-200");
          }
          if (playingBadge) {
            playingBadge.classList.remove("hidden");
            playingBadge.classList.add("inline-block");
          }
        } else {
          item.classList.remove("bg-[#ff9f1c]/25", "shadow-lg");
          if (item.classList.contains("drawer-song-item")) {
            item.classList.add("bg-[#150f24]");
          } else {
            item.classList.add("bg-white/[0.03]");
          }
          if (titleText) {
            titleText.classList.remove("text-[#ff9f1c]", "font-bold");
            titleText.classList.add("text-[#f5f0e1]");
          }
          if (playingBadge) {
            playingBadge.classList.add("hidden");
            playingBadge.classList.remove("inline-block");
          }
        }
      });
    }

    function updateSliderFill(slider, percent) {
      if (!slider) return;
      const val = Math.min(100, Math.max(0, percent));
      slider.style.background = `linear-gradient(to right, #ff9f1c 0%, #ff9f1c ${val}%, rgba(245, 240, 225, 0.15) ${val}%, rgba(245, 240, 225, 0.15) 100%)`;
    }

    function startProgressTimer() {
      setInterval(() => {
        if (isPlayerReady && player && player.getCurrentTime) {
          const current = player.getCurrentTime() || 0;
          const total = player.getDuration() || 0;
          const slider = document.getElementById("player-seek-slider");
          const timeCur = document.getElementById("player-current-time");
          const timeTot = document.getElementById("player-total-duration");
          if (slider && total > 0) {
            const percent = (current / total) * 100;
            slider.value = percent;
            updateSliderFill(slider, percent);
          }
          if (timeCur) timeCur.innerText = formatTime(current);
          if (timeTot) timeTot.innerText = formatTime(total);

          if (current > 0) {
            localStorage.setItem("chatpate_last_playback_time", current.toFixed(2));
            localStorage.setItem("chatpate_last_song_index", currentSongIndex);
            if (songsData[currentSongIndex]) {
              localStorage.setItem("chatpate_last_song_id", songsData[currentSongIndex].id);
            }
          }
        }
      }, 500);
    }

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
    }

    document.addEventListener("DOMContentLoaded", () => {
      const seekSlider = document.getElementById("player-seek-slider");
      if (seekSlider) updateSliderFill(seekSlider, 0);

      const volSlider = document.getElementById("player-volume-slider");
      if (volSlider) {
        updateSliderFill(volSlider, volSlider.value);
        volSlider.addEventListener("input", (e) => {
          updateSliderFill(volSlider, e.target.value);
          if (isPlayerReady && player && player.setVolume) {
            player.setVolume(e.target.value);
          }
        });
      }

      seekSlider?.addEventListener("input", (e) => {
        const val = e.target.value;
        updateSliderFill(seekSlider, val);
        if (isPlayerReady && player && player.getDuration) {
          const seekTo = (val / 100) * player.getDuration();
          player.seekTo(seekTo, true);
        }
      });

      document
        .getElementById("player-play-toggle-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          if (!isPlayerReady || !player) return;
          if (isPlaying) player.pauseVideo();
          else player.playVideo();
        });

      document
        .getElementById("drawer-bottom-play-btn")
        ?.addEventListener("click", () => {
          document.getElementById("player-play-toggle-btn")?.click();
        });

      document
        .getElementById("player-next-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          playNextTrack();
        });
      document
        .getElementById("drawer-bottom-next-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          playNextTrack();
        });
      document
        .getElementById("player-prev-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          playPrevTrack();
        });

      document
        .getElementById("player-shuffle-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          isShuffle = !isShuffle;
          document
            .getElementById("shuffle-indicator")
            ?.classList.toggle("hidden", !isShuffle);
        });
      document
        .getElementById("player-repeat-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          isRepeat = !isRepeat;
          document
            .getElementById("repeat-indicator")
            ?.classList.toggle("hidden", !isRepeat);
        });

      document
        .getElementById("player-mute-btn")
        ?.addEventListener("click", () => {
          playSFX("click");
          if (!isPlayerReady || !player) return;
          isMuted = !isMuted;
          if (isMuted) player.mute();
          else player.unMute();
          const muteBtn = document.getElementById("player-mute-btn");
          if (muteBtn) {
            muteBtn.innerHTML = isMuted
              ? `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>`
              : `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>`;
          }
        });

      function updateExcludedUI() {
        document.querySelectorAll(".drawer-song-item").forEach((item) => {
          const songId = item.getAttribute("data-song-id");
          const isExcluded = excludedSongIds.has(songId);
          const btn = item.querySelector(".exclude-toggle-btn");
          if (isExcluded) {
            item.classList.add("opacity-40", "pointer-events-none", "grayscale");
            if (btn) {
              btn.classList.add("text-red-400", "pointer-events-auto");
              btn.classList.remove("text-[#a39b8e]");
              btn.setAttribute("title", "Excluded - Click to restore");
            }
          } else {
            item.classList.remove("opacity-40", "pointer-events-none", "grayscale");
            if (btn) {
              btn.classList.remove("text-red-400");
              btn.classList.add("text-[#a39b8e]");
              btn.setAttribute("title", "Exclude from playback");
            }
          }
        });
      }

      updateExcludedUI();

      document.querySelectorAll(".exclude-toggle-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          playSFX("click");
          const songId = btn.getAttribute("data-exclude-id");
          if (!songId) return;
          if (excludedSongIds.has(songId)) {
            excludedSongIds.delete(songId);
          } else {
            excludedSongIds.add(songId);
          }
          localStorage.setItem('chatpate_excluded_songs', JSON.stringify(Array.from(excludedSongIds)));
          updateExcludedUI();
        });
      });

      document.querySelectorAll(".drawer-song-item").forEach((item) => {
        item.addEventListener("click", (e) => {
          const songId = item.getAttribute("data-song-id");
          if (excludedSongIds.has(songId)) {
            e.stopPropagation();
            return;
          }
          const index = songsData.findIndex((s) => s.id === songId);
          if (index !== -1) loadSong(index, true);
        });
      });

      const searchInput = document.getElementById("drawer-search-input");
      searchInput?.addEventListener("input", (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;
        document.querySelectorAll(".drawer-song-item").forEach((item) => {
          const title = (item.getAttribute("data-song-title") || "").toLowerCase();
          const artist = (item.getAttribute("data-song-artist") || "").toLowerCase();
          const matches = title.includes(query) || artist.includes(query);
          item.classList.toggle("hidden", !matches);
          if (matches) visibleCount++;
        });
        const countEl = document.getElementById("drawer-count");
        if (countEl) countEl.innerText = String(visibleCount);
      });

      const drawer = document.getElementById("playlist-drawer");
      const backdrop = document.getElementById("drawer-backdrop");

      const openDrawer = () => {
        playSFX("click");
        drawer?.classList.remove("translate-x-full");
        backdrop?.classList.remove("hidden");
        setTimeout(() => backdrop?.classList.remove("opacity-0"), 10);
      };

      const closeDrawer = () => {
        playSFX("click");
        drawer?.classList.add("translate-x-full");
        backdrop?.classList.add("opacity-0");
        setTimeout(() => backdrop?.classList.add("hidden"), 300);
      };

      document
        .getElementById("drawer-open-btn")
        ?.addEventListener("click", openDrawer);
      document
        .getElementById("drawer-close-btn")
        ?.addEventListener("click", closeDrawer);
      backdrop?.addEventListener("click", closeDrawer);

      // Formspree Suggestion & Feedback Modal Handlers
      const sugModal = document.getElementById("feedback-modal");
      const sugBackdrop = document.getElementById("feedback-backdrop");
      const closeSugBtn = document.getElementById("close-feedback-btn");
      const openSugBtn = document.getElementById("open-suggestion-btn");

      const noteModal = document.getElementById("general-feedback-modal");
      const noteBackdrop = document.getElementById("general-feedback-backdrop");
      const closeNoteBtn = document.getElementById("close-general-feedback-btn");
      const openNoteBtn = document.getElementById("open-feedback-btn");

      const openModalHelper = (m, b) => {
        playSFX("click");
        m?.classList.remove("opacity-0", "pointer-events-none", "scale-95");
        m?.classList.add("opacity-100", "scale-100");
        b?.classList.remove("opacity-0", "pointer-events-none");
        b?.classList.add("opacity-100");
      };

      const closeModalHelper = (m, b) => {
        playSFX("click");
        m?.classList.remove("opacity-100", "scale-100");
        m?.classList.add("opacity-0", "pointer-events-none", "scale-95");
        b?.classList.remove("opacity-100");
        b?.classList.add("opacity-0", "pointer-events-none");
      };

      openSugBtn?.addEventListener("click", () => openModalHelper(sugModal, sugBackdrop));
      closeSugBtn?.addEventListener("click", () => closeModalHelper(sugModal, sugBackdrop));
      sugBackdrop?.addEventListener("click", () => closeModalHelper(sugModal, sugBackdrop));

      openNoteBtn?.addEventListener("click", () => openModalHelper(noteModal, noteBackdrop));
      closeNoteBtn?.addEventListener("click", () => closeModalHelper(noteModal, noteBackdrop));
      noteBackdrop?.addEventListener("click", () => closeModalHelper(noteModal, noteBackdrop));

      window.addEventListener("keydown", (e) => {
        if (["INPUT", "TEXTAREA"].includes(document.activeElement.tagName))
          return;
        if (e.code === "Space" || e.key === "k" || e.key === "K") {
          e.preventDefault();
          document.getElementById("player-play-toggle-btn")?.click();
        } else if (e.key === "ArrowRight" || e.key === "l" || e.key === "L") {
          playNextTrack();
        } else if (e.key === "ArrowLeft" || e.key === "j" || e.key === "J") {
          playPrevTrack();
        } else if (e.key === "s" || e.key === "S") {
          document.getElementById("player-shuffle-btn")?.click();
        } else if (e.key === "r" || e.key === "R") {
          document.getElementById("player-repeat-btn")?.click();
        } else if (e.key === "m" || e.key === "M") {
          document.getElementById("player-mute-btn")?.click();
        } else if (e.key === "q" || e.key === "Q") {
          openDrawer();
        } else if (e.key === "Escape") {
          closeDrawer();
        }
      });

      window.addEventListener("beforeunload", () => {
        if (isPlayerReady && player && player.getCurrentTime) {
          try {
            const cur = player.getCurrentTime() || 0;
            localStorage.setItem("chatpate_last_playback_time", cur.toFixed(2));
            localStorage.setItem("chatpate_last_song_index", currentSongIndex);
            if (songsData[currentSongIndex]) {
              localStorage.setItem("chatpate_last_song_id", songsData[currentSongIndex].id);
            }
          } catch (e) {}
        }
      });
    });
  </script>
</MainLayout>
