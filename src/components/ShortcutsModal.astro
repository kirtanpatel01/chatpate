---
---

<div id="shortcuts-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
  <div class="editorial-card w-full max-w-md bg-[#120e1d] rounded-2xl p-6 border border-white/10 relative space-y-6">
    
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="flex items-center gap-3">
        <span class="text-xl">⌨️</span>
        <div>
          <h3 class="font-display text-lg text-white">KEYBOARD SHORTCUTS</h3>
          <p class="text-xs text-slate-400 font-mono">Control Chatpate seamlessly</p>
        </div>
      </div>
      <button id="shortcuts-close-btn" class="text-slate-400 hover:text-white text-xl">✕</button>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Play / Pause</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">Space</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Play / Pause</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">K</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Next Track</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">→</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Prev Track</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">←</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Toggle Shuffle</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">S</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Toggle Repeat</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">R</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Mute / Unmute</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">M</kbd>
      </div>

      <div class="bg-[#0a0812] p-3 rounded-lg border border-white/10 flex items-center justify-between">
        <span class="text-slate-300">Open Queue</span>
        <kbd class="px-2 py-0.5 rounded font-mono bg-white/10 text-white">Q</kbd>
      </div>
    </div>

    <div class="text-center pt-2">
      <p class="text-[11px] text-slate-400">Press <kbd class="text-[#ffea00] font-mono">Esc</kbd> anytime to close dialogs</p>
    </div>

  </div>
</div>
