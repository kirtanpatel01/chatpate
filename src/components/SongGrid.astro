---
import categoriesData from '../data/categories.json';
import songsData from '../data/songs.json';
---

<section id="song-grid-section" class="w-full max-w-7xl mx-auto px-6 py-12 z-10 relative">
  
  <!-- Category Filtering Tabs Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 bg-[#120d20] p-6 rounded-2xl">
    <div class="space-y-1">
      <span class="text-xs font-mono font-bold text-[#ff007f] tracking-widest uppercase">MUSIC ARCHIVE</span>
      <h2 class="font-display text-3xl sm:text-4xl text-white">
        CURATED BANGERS
      </h2>
    </div>

    <!-- Minimal Category Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 custom-scrollbar">
      {categoriesData.map((cat) => (
        <button
          data-category={cat.id}
          class={`mood-tab-btn px-4 py-2 rounded-lg font-heading text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
            cat.id === 'all'
              ? 'bg-[#ff9f1c] text-black font-bold'
              : 'text-[#a39b8e] bg-[#1d1630] hover:bg-[#2c2048] hover:text-white'
          }`}
        >
          {cat.name}
        </button>
      ))}
    </div>
  </div>

  <!-- Editorial Tracklist Archive (Clean Numbered Rows) -->
  <div id="songs-container" class="space-y-1.5">
    {songsData.map((song, idx) => (
      <div
        data-song-id={song.id}
        data-song-title={song.title}
        data-song-artist={song.artist}
        data-song-category={song.category}
        data-song-index={idx}
        class="song-card editorial-card px-4 py-3.5 rounded-xl flex items-center justify-between gap-4 group cursor-pointer bg-white/[0.02] hover:bg-white/[0.07] transition-all"
      >
        <!-- Left Track Number & Metadata -->
        <div class="flex items-center gap-4 sm:gap-6 overflow-hidden">
          <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-[#ff007f] w-8 shrink-0">
            #{song.trackNumber}
          </span>

          <div class="truncate">
            <h4 class="font-heading font-semibold text-sm sm:text-base text-slate-200 group-hover:text-white truncate">
              {song.title}
            </h4>
            <p class="text-xs text-slate-400 truncate pt-0.5">
              {song.artist}
            </p>
          </div>
        </div>

        <!-- Right Category & Play Trigger -->
        <div class="flex items-center gap-4 shrink-0">
          <span class="text-[10px] font-mono text-slate-400 uppercase hidden sm:inline">
            {song.category.replace('-', ' ')}
          </span>
          <div class="w-8 h-8 rounded-lg bg-white/5 text-slate-300 group-hover:bg-[#ff007f] group-hover:text-white flex items-center justify-center text-xs transition-colors">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>
        </div>

      </div>
    ))}
  </div>

</section>
