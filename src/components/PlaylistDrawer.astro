---
import songsData from '../data/songs.json';
---

<div id="drawer-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md z-40 hidden opacity-0 transition-opacity duration-300"></div>

<aside
  id="playlist-drawer"
  class="fixed top-0 right-0 w-full max-w-[440px] h-full bg-[#07050a]/95 border-l border-white/10 z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between"
>
  <!-- Drawer Header -->
  <div class="p-6 border-b border-white/10 space-y-4 shrink-0 bg-[#09070e]">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="font-serif text-xl text-[#f5f0e1]">Song Catalog</h3>
        <p class="text-xs text-[#a39b8e] font-mono"><span id="drawer-count">{songsData.length}</span> Tracks Curated</p>
      </div>
      <button id="drawer-close-btn" class="text-[#a39b8e] hover:text-white text-xl">✕</button>
    </div>

    <!-- Search Input -->
    <div class="relative">
      <input
        type="text"
        id="drawer-search-input"
        placeholder="Search tracks..."
        class="w-full bg-[#07050a] border border-white/10 px-4 py-2.5 text-xs text-[#f5f0e1] focus:outline-none focus:border-[#ff9f1c] placeholder:text-[#a39b8e]/50 font-sans"
      />
    </div>
  </div>

  <!-- Songs List Container (Visual Browser Rows with Singer Names and Exclude Toggle) -->
  <div id="drawer-songs-list" class="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">
    {songsData.map((song, idx) => (
      <div
        data-song-id={song.id}
        data-song-title={song.title}
        data-song-artist={song.artist}
        data-drawer-index={idx}
        class="drawer-song-item p-2.5 flex items-center justify-between gap-3 group cursor-pointer border border-white/5 bg-white/[0.02] hover:border-white/20 hover:bg-white/5 transition-all relative overflow-hidden"
      >
        <div class="flex items-center gap-3 overflow-hidden">
          <!-- Track Thumbnail Visual -->
          <div class="relative w-12 h-12 shrink-0 overflow-hidden bg-black/60 border border-white/10 flex items-center justify-center">
            <img
              src={`https://img.youtube.com/vi/${song.id}/mqdefault.jpg`}
              alt={song.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-[#ff9f1c]">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </div>

          <!-- Song Title & Singer Name -->
          <div class="truncate space-y-0.5">
            <p class="drawer-title-text font-sans font-medium text-xs sm:text-sm text-[#f5f0e1] group-hover:text-[#ff9f1c] truncate transition-colors">
              {song.title}
            </p>
            <p class="text-[11px] font-sans font-light text-[#a39b8e] truncate">
              {song.artist}
            </p>
          </div>
        </div>

        <!-- Exclude Toggle Action Button -->
        <button
          type="button"
          data-exclude-id={song.id}
          class="exclude-toggle-btn shrink-0 p-1.5 text-xs text-[#a39b8e] hover:text-[#ff9f1c] hover:bg-white/10 transition-all"
          title="Exclude from playback"
          onclick="event.stopPropagation();"
        >
          <svg class="w-4 h-4 fill-current pointer-events-none" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-4.42-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31C15.55 19.37 13.85 20 12 20zm5.31-3.1L6.1 5.69C7.45 4.63 9.15 4 12 4c4.42 0 8 4.42 8 8 0 1.85-.63 3.55-1.69 4.9z"/></svg>
        </button>
      </div>
    ))}
  </div>
</aside>
