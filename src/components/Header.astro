---
import songsData from "../data/songs.json";
---

<header class="w-full max-w-7xl mx-auto px-2 sm:px-6 py-2 sm:py-4 z-20 shrink-0">
  <div
    class="glass-pill-header px-3 sm:px-5 py-2.5 flex items-center justify-between gap-2"
  >
    <!-- Minimalist Quiet Wordmark with Custom Icon Image -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="w-8 h-8 flex items-center justify-center overflow-hidden">
        <img src="/icon.png" alt="Chatpate Icon" class="w-full h-full object-cover" />
      </div>
      <h1
        class="font-serif text-lg sm:text-2xl tracking-wider text-[#f5f0e1] group-hover:text-[#ff9f1c] transition-colors m-0 p-0 font-normal"
      >
        Chatpate
      </h1>
    </a>

    <!-- Minimal Header Controls -->
    <div class="flex items-center gap-2 sm:gap-4 shrink-0">
      <a
        href="/songs"
        class="text-xs sm:text-sm font-mono text-[#a39b8e] hover:text-[#f5f0e1] transition-colors px-2.5 sm:px-3 py-1 bg-white/5 hover:bg-white/10"
        title="View All Songs Catalog"
      >
        Catalog
      </a>

      <button
        id="sfx-toggle-btn"
        class="text-xs sm:text-sm font-mono text-[#a39b8e] hover:text-[#f5f0e1] transition-colors flex items-center gap-1.5 px-2.5 sm:px-3 py-1 bg-white/5 hover:bg-white/10 cursor-pointer"
        title="Toggle UI Sound Effects"
      >
        <span id="sfx-icon" class="flex items-center">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        </span>
        <span class="hidden sm:inline">sfx</span>
      </button>

      <button
        id="drawer-open-btn"
        class="text-xs sm:text-sm font-mono text-[#ff9f1c] hover:text-white transition-colors bg-[#ff9f1c]/20 hover:bg-[#ff9f1c]/35 px-3 sm:px-4 py-1 sm:py-1.5 flex items-center gap-1.5 cursor-pointer"
      >
        <span>Queue</span>
        <span class="text-xs text-[#a39b8e] bg-black/40 px-1.5 py-0.5" id="header-song-count">{songsData.length}</span>
      </button>
    </div>
  </div>
</header>
