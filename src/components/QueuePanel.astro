---
import songsData from '../data/songs.json';
import categoriesData from '../data/categories.json';
const sortedSongs = [...songsData].sort((a, b) => a.title.localeCompare(b.title));
---

<div class="glass-panel p-5 rounded-3xl h-full flex flex-col justify-between space-y-4">
  
  <!-- Queue Header & Live Search -->
  <div class="space-y-3 shrink-0">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 fill-current text-[#ff007f]" viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        <h3 class="font-heading font-bold text-sm text-white">PLAYLIST QUEUE</h3>
      </div>
      <span class="text-[11px] font-mono text-[#ffea00] bg-black/60 px-2 py-0.5 rounded">
        <span id="queue-total-count">86</span> Tracks
      </span>
    </div>

    <!-- Search Input -->
    <div class="relative">
      <input
        type="text"
        id="queue-search-input"
        placeholder="Search track or artist..."
        class="w-full bg-[#130d24] focus:bg-[#1c1336] rounded-xl px-3 py-1.5 pl-8 text-xs text-[#f5f0e1] focus:outline-none placeholder:text-slate-500 transition-all"
      />
      <svg class="w-3.5 h-3.5 fill-current text-slate-500 absolute left-2.5 top-2.5" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
    </div>

    <!-- Mood Quick Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 custom-scrollbar">
      {categoriesData.map((cat) => (
        <button
          data-category={cat.id}
          class="queue-cat-pill text-[10px] font-heading font-semibold px-2.5 py-1 rounded-lg bg-[#140e26] hover:bg-[#22183d] text-slate-300 hover:text-white whitespace-nowrap cursor-pointer transition-all"
        >
          {cat.name}
        </button>
      ))}
    </div>
  </div>

  <!-- Songs Rows Container -->
  <div id="queue-songs-list" class="flex-1 overflow-y-auto pr-1 space-y-1.5 custom-scrollbar max-h-[500px]">
    {sortedSongs.map((song, idx) => (
      <div
        data-song-id={song.id}
        data-song-title={song.title}
        data-song-artist={song.artist}
        data-song-category={song.category}
        data-queue-index={idx}
        class="queue-song-item glass-panel p-2.5 rounded-xl flex items-center justify-between gap-3 group cursor-pointer bg-white/[0.03] hover:bg-white/[0.08] transition-all"
      >
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="font-mono text-[11px] font-bold text-slate-500 group-hover:text-[#ff007f] w-5 text-center shrink-0">
            #{song.trackNumber}
          </span>
          <div class="truncate">
            <div class="flex items-center gap-1.5">
              <h4 class="font-heading font-semibold text-xs text-slate-200 group-hover:text-white truncate">
                {song.title}
              </h4>
              <span class="now-playing-badge hidden text-[9px] font-mono font-bold bg-[#ff9f1c] text-black px-1.5 py-0.5 uppercase tracking-wider shrink-0">PLAYING</span>
            </div>
            <p class="text-[10px] text-slate-400 truncate">
              {song.artist}
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0" onclick="event.stopPropagation();">
          <label class="flex items-center gap-1 text-[10px] font-mono text-slate-500 hover:text-[#ff007f] cursor-pointer" title="Skip during playback">
            <input type="checkbox" data-exclude-id={song.id} class="exclude-checkbox accent-[#ff007f]" />
            <span class="hidden sm:inline">Skip</span>
          </label>
        </div>
      </div>
    ))}
  </div>

</div>
