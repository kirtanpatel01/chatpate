---
import songsData from '../data/songs.json';
import categoriesData from '../data/categories.json';
---

<div class="glass-panel p-5 rounded-3xl h-full flex flex-col justify-between space-y-4 border-white/10">
  
  <!-- Queue Header & Live Search -->
  <div class="space-y-3 shrink-0">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-sm">🎶</span>
        <h3 class="font-heading font-bold text-sm text-white">PLAYLIST QUEUE</h3>
      </div>
      <span class="text-[11px] font-mono text-[#ffea00] bg-black/40 px-2 py-0.5 rounded border border-white/10">
        <span id="queue-total-count">86</span> Tracks
      </span>
    </div>

    <!-- Search Input -->
    <div class="relative">
      <input
        type="text"
        id="queue-search-input"
        placeholder="Search track or artist..."
        class="w-full bg-[#07030e]/80 border border-white/10 rounded-xl px-3 py-1.5 pl-8 text-xs text-white focus:outline-none focus:border-[#ff007f] placeholder:text-slate-500"
      />
      <span class="absolute left-2.5 top-2 text-[11px] text-slate-500">🔍</span>
    </div>

    <!-- Mood Quick Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 custom-scrollbar">
      {categoriesData.map((cat) => (
        <button
          data-category={cat.id}
          class="queue-cat-pill text-[10px] font-heading font-semibold px-2.5 py-1 rounded-lg border border-white/10 bg-[#07030e]/50 text-slate-400 hover:text-white whitespace-nowrap"
        >
          {cat.name}
        </button>
      ))}
    </div>
  </div>

  <!-- Songs Rows Container -->
  <div id="queue-songs-list" class="flex-1 overflow-y-auto pr-1 space-y-1.5 custom-scrollbar max-h-[500px]">
    {songsData.map((song, idx) => (
      <div
        data-song-id={song.id}
        data-song-title={song.title}
        data-song-artist={song.artist}
        data-song-category={song.category}
        data-queue-index={idx}
        class="queue-song-item glass-panel p-2.5 rounded-xl flex items-center justify-between gap-3 group cursor-pointer border-transparent hover:border-white/20 transition-all"
      >
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="font-mono text-[11px] font-bold text-slate-500 group-hover:text-[#ff007f] w-5 text-center shrink-0">
            #{song.trackNumber}
          </span>
          <div class="truncate">
            <h4 class="font-heading font-semibold text-xs text-slate-200 group-hover:text-white truncate">
              {song.title}
            </h4>
            <p class="text-[10px] text-slate-400 truncate">
              {song.artist}
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0" onclick="event.stopPropagation();">
          <label class="flex items-center gap-1 text-[10px] font-mono text-slate-500 hover:text-[#ff007f] cursor-pointer" title="Skip during playback">
            <input type="checkbox" data-exclude-id={song.id} class="exclude-checkbox accent-[#ff007f]" />
            <span class="hidden sm:inline">Skip</span>
          </label>
        </div>
      </div>
    ))}
  </div>

</div>
