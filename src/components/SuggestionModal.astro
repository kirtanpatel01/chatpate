---
---

<!-- Backdrop Overlay -->
<div 
  id="feedback-backdrop" 
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-40 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<!-- Modal Dialog -->
<div 
  id="feedback-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 pointer-events-none opacity-0 scale-95 transition-all duration-300 ease-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="feedback-title"
>
  <div class="w-full max-w-md bg-[#07050a]/95 backdrop-blur-2xl border border-white/15 shadow-2xl p-6 sm:p-7 text-[#f5f0e1] relative max-h-[85vh] sm:max-h-[90vh] overflow-y-auto custom-scrollbar select-none">
    
    <!-- Close Button -->
    <div class="absolute top-5 right-5 group">
      <button 
        type="button"
        id="close-feedback-btn" 
        aria-label="Close form"
        class="text-[#a39b8e] hover:text-[#f5f0e1] transition-colors p-1 cursor-pointer focus:outline-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Header -->
    <div class="space-y-1 pr-8">
      <h2 id="feedback-title" class="font-serif text-2xl sm:text-3xl text-[#f5f0e1] tracking-wide">
        Suggest a song
      </h2>
      <p class="font-sans text-xs sm:text-sm text-[#a39b8e] font-light leading-relaxed">
        Know a song that belongs in Chatpate — or one that doesn't?
      </p>
    </div>

    <!-- Success View -->
    <div id="feedback-success-container" class="hidden text-center py-8 space-y-4">
      <div class="w-10 h-10 border border-[#ff9f1c]/40 text-[#ff9f1c] flex items-center justify-center mx-auto text-lg">
        ✓
      </div>
      <div class="space-y-1.5">
        <h3 class="font-serif text-2xl sm:text-3xl text-[#f5f0e1] tracking-wide">
          Sent. Thank you!
        </h3>
        <p class="font-sans text-xs sm:text-sm text-[#a39b8e] font-light leading-relaxed">
          Your song suggestion has reached Chatpate.
        </p>
      </div>
      <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-2">
        <button 
          id="close-feedback-success-btn" 
          type="button"
          class="w-full sm:w-auto px-5 py-2 bg-[#ff9f1c] hover:bg-[#ff8f00] text-black font-sans font-medium text-xs tracking-wider transition-all cursor-pointer shadow-md"
        >
          Close
        </button>
        <button 
          id="feedback-reset-btn" 
          type="button"
          class="w-full sm:w-auto px-4 py-2 bg-white/5 hover:bg-white/10 text-[#f5f0e1] font-sans text-xs tracking-wider transition-all cursor-pointer border border-white/10"
        >
          Submit another suggestion
        </button>
      </div>
    </div>

    <!-- Form View -->
    <form id="feedback-form" action="https://formspree.io/f/xbgjdyyb" method="POST" class="mt-6 space-y-4 font-sans text-left">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <input type="hidden" name="form_type" value="song_suggestion" />

      <!-- 1. Feedback Type (Pill / Choice) -->
      <div class="space-y-2">
        <label class="block text-[10px] font-sans font-medium tracking-wider text-[#a39b8e] uppercase">
          I'd like to...
        </label>
        <input type="hidden" name="feedback_type" id="feedback-type-hidden" value="Add a song" />
        <div class="grid grid-cols-2 gap-2">
          <button 
            type="button" 
            data-value="Add a song"
            class="feedback-type-btn py-2 px-2 text-xs font-sans border transition-all cursor-pointer text-center bg-[#ff9f1c]/20 text-[#ff9f1c] border-[#ff9f1c]/50 font-medium focus:outline-none"
          >
            + Add a song
          </button>
          <button 
            type="button" 
            data-value="Remove a song"
            class="feedback-type-btn py-2 px-2 text-xs font-sans border transition-all cursor-pointer text-center border-white/10 text-[#a39b8e] hover:text-[#f5f0e1] hover:border-white/20 bg-transparent focus:outline-none"
          >
            - Remove a song
          </button>
        </div>
      </div>

      <!-- 2. Song Title -->
      <div id="field-group-song-title" class="space-y-1.5">
        <label for="feedback-song-title" class="block text-xs font-sans font-medium text-[#f5f0e1] tracking-wide">
          Song <span id="song-title-required-star" class="text-[#ff9f1c]">*</span>
        </label>
        <input 
          type="text" 
          id="feedback-song-title" 
          name="song_title" 
          maxlength="200"
          placeholder="Song name" 
          class="w-full bg-white/5 border border-white/10 px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-[#a39b8e]/50 focus:outline-none focus:border-[#ff9f1c] transition-all font-sans"
        />
        <p id="error-song-title" class="hidden text-[11px] text-rose-400 pt-0.5">Please enter a song title.</p>
      </div>

      <!-- 3. Artist -->
      <div id="field-group-artist" class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-artist" class="block text-xs font-sans font-medium text-[#f5f0e1] tracking-wide">
            Artist
          </label>
          <span class="text-[#a39b8e]/70 text-[11px] font-sans">Optional</span>
        </div>
        <input 
          type="text" 
          id="feedback-artist" 
          name="artist" 
          maxlength="200"
          placeholder="Artist name" 
          class="w-full bg-white/5 border border-white/10 px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-[#a39b8e]/50 focus:outline-none focus:border-[#ff9f1c] transition-all font-sans"
        />
      </div>

      <!-- 4. Tell us why -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-reason" class="block text-xs font-sans font-medium text-[#f5f0e1] tracking-wide">
            Tell us why
          </label>
          <span class="text-[#a39b8e]/70 text-[11px] font-sans">Optional</span>
        </div>
        <textarea 
          id="feedback-reason" 
          name="reason" 
          rows="3" 
          maxlength="1000"
          placeholder="What makes it belong here?" 
          class="w-full bg-white/5 border border-white/10 px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-[#a39b8e]/50 focus:outline-none focus:border-[#ff9f1c] transition-all resize-none leading-relaxed font-sans"
        ></textarea>
      </div>

      <div class="pt-2 pb-1 border-t border-white/5"></div>

      <!-- 5. Name -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-name" class="block text-xs font-sans font-medium text-[#f5f0e1] tracking-wide">
            Your name
          </label>
          <span class="text-[#a39b8e]/70 text-[11px] font-sans">Optional</span>
        </div>
        <input 
          type="text" 
          id="feedback-name" 
          name="name" 
          maxlength="100"
          placeholder="Your name" 
          class="w-full bg-white/5 border border-white/10 px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-[#a39b8e]/50 focus:outline-none focus:border-[#ff9f1c] transition-all font-sans"
        />
      </div>

      <!-- Error Alert Banner -->
      <div id="feedback-error-banner" class="hidden text-xs text-rose-300 bg-rose-950/40 border border-rose-500/30 p-3 flex items-start space-x-2">
        <span id="error-banner-text">Could not send submission. Please try again.</span>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button 
          type="submit" 
          id="feedback-submit-btn" 
          class="w-full py-3 px-4 bg-[#ff9f1c] hover:bg-[#ff8f00] text-black font-sans font-medium text-xs sm:text-sm tracking-wide transition-all cursor-pointer shadow-lg active:scale-[0.99] flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submit-btn-text">Send it our way</span>
        </button>
      </div>
    </form>
  </div>
</div>
