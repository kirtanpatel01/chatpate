---
---

<section class="w-full max-w-7xl mx-auto px-6 py-12 md:py-16 relative z-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Left Column: Typography & Intentional Primary Action -->
    <div class="lg:col-span-6 space-y-6">
      
      <div class="space-y-2">
        <span class="text-xs font-mono font-bold tracking-widest text-[#ff007f] uppercase">
          BOLLYWOOD & DESI BANGERS • 2010s ERA
        </span>
        <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl tracking-tight leading-none text-white">
          BAS VOLUME<br/>
          <span class="text-[#ff007f]">BADHA.</span>
        </h1>
      </div>

      <p class="font-body text-base sm:text-lg text-slate-300 max-w-md leading-relaxed">
        Gaane jo mood ko seedha 100% pe le jaayein. High-energy party bangers, wedding track anthems, and road trip memories.
      </p>

      <!-- Primary Action -->
      <div class="pt-2 flex flex-wrap items-center gap-4">
        <button
          id="hero-play-btn"
          class="editorial-btn-accent px-8 py-4 rounded-xl text-sm font-heading flex items-center gap-3 shadow-lg shadow-[#ff007f]/20 hover:shadow-[#ff007f]/40"
        >
          <span class="text-lg">▶</span>
          <span>SHUFFLE PARTY MODE</span>
        </button>

        <a
          href="#player-section"
          class="text-xs font-heading font-semibold text-slate-400 hover:text-white px-5 py-4 rounded-xl border border-white/10 transition-colors flex items-center gap-2"
        >
          <span>Jump to Player</span>
          <span>↓</span>
        </a>
      </div>

    </div>

    <!-- Right Column: Asymmetric Artwork Composition -->
    <div class="lg:col-span-6 relative">
      <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <img
          src="/bg.png"
          alt="Chatpate Editorial Artwork"
          class="w-full h-full object-cover filter contrast-[1.05]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0812] via-transparent to-transparent opacity-80"></div>
        
        <!-- Artwork Caption -->
        <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between">
          <div class="space-y-1">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block">FEATURED ARTWORK</span>
            <p class="font-heading font-bold text-sm text-white">Pop-Art Music Culture</p>
          </div>
          <span class="text-xs font-mono text-[#ffea00] bg-black/60 backdrop-blur-md px-2.5 py-1 rounded border border-white/10">
            86 Tracks
          </span>
        </div>
      </div>
    </div>

  </div>
</section>
